{
  "name": "@horas/shared-types",
  "version": "0.0.0",
  "private": true,
  "description": "Domain types and enums shared by the HORAS front end and back end",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
