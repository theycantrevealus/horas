{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@utility/*": ["./apps/utility/*"],
      "@configuration/*": ["./apps/configuration/*"],
      "@repository/*": ["./apps/repository/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/gateway_back_office/tsconfig.app.json"
    },
    {
      "path": "./apps/worker/tsconfig.app.json"
    }
  ]
}
