{
  "name": "@horas/back-end",
  "version": "0.0.1",
  "description": "HORAS",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build gateway_back_office && nest build worker",
    "build:gateway": "nest build gateway_back_office",
    "build:worker": "nest build worker",
    "format": "prettier --write --no-error-on-unmatched-pattern \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start gateway_back_office",
    "start:dev": "nest start gateway_back_office --watch",
    "start:dev:worker": "nest start worker --watch",
    "start:debug": "nest start gateway_back_office --debug --watch",
    "start:prod": "node dist/apps/gateway_back_office/main",
    "start:prod:worker": "node dist/apps/worker/main",
    "lint": "oxlint --type-aware apps/",
    "type-check": "tsc -p apps/gateway_back_office/tsconfig.app.json --noEmit && tsc -p apps/worker/tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@horas/api-contracts": "workspace:*",
    "@horas/shared-types": "workspace:*",
    "@horas/shared-utils": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-fastify": "^12.3.2",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "joi": "^18.3.1",
    "jose": "^6.2.15",
    "moment-timezone": "^0.6.6",
    "mongoose": "^9.11.4",
    "nest-winston": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.1.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}
